"top","containerId":null,"originalText":"7 - Quais partes do sistema poderão evoluir na próximas fases?","autoResize":true,"lineHeight":1.25},{"id":"JkKC3odSOlO32TmQAS0-u","type":"line","x":1596.4696370604277,"y":3383.2120026011467,"width":610.8813055489416,"height":0,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":["-GswmAHaSxw4YS4C86Aqm"],"frameId":null,"index":"b0H","roundness":{"type":2},"seed":983711122,"version":1417,"versionNonce":1974489117,"isDeleted":false,"boundElements":[],"updated":1785885670969,"link":null,"locked":false,"points":[[0,0],[610.8813055489416,0]],"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":null,"polygon":false},{"id":"_RgVMwS4SW-XHRtEJB1Ho","type":"text","x":1580.7480812739093,"y":712.4172703671238,"width":1152.9787445068357,"height":75,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b0I","roundness":null,"seed":1770537230,"version":1684,"versionNonce":1633762507,"isDeleted":false,"boundElements":[],"updated":1786579922513,"link":null,"locked":false,"text":"Dados cadastrais e classes de risco de produtos químicos, informações de volume/quantidade das cargas, tipo ou\nconteúdo da carga, status do ciclo de vida da carga, documentações obrigatórias (laudos e licenças), histórico de\ninspeções, áreas de armazenamento, a identificação do responsável técnico e origem e destino da carga.","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Dados cadastrais e classes de risco de produtos químicos, informações de volume/quantidade das cargas, tipo ou conteúdo da carga, status do ciclo de vida da carga, documentações obrigatórias (laudos e licenças), histórico de inspeções, áreas de armazenamento, a identificação do responsável técnico e origem e destino da carga.","autoResize":false,"lineHeight":1.25},{"id":"suT59eCu5fnxG51TOPQU7","type":"ellipse","x":877.8197651273008,"y":-485.7597496301246,"width":1057.7777099609375,"height":222.22218831380212,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":4,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b0R","roundness":{"type":2},"seed":239057362,"version":175,"versionNonce":999753353,"isDeleted":false,"boundElements":[],"updated":1785885091760,"link":null,"locked":false},{"id":"ZUoAMWsWd4zcqVLrFZ7Qa","type":"image","x":-687.6071044035516,"y":1271.240570804446,"width":762.4097693351423,"height":390.2055555555555,"angle":0,"strokeColor":"transparent","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":4,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b0S","roundness":null,"seed":721739794,"version":269,"versionNonce":1374113129,"isDeleted":false,"boundElements":[],"updated":1785885091760,"link":null,"locked":false,"status":"saved","fileId":"fa4560019041fb7ea9fc556fd3fc2da603b4c15a","scale":[1,1],"crop":null},{"id":"xGb5kl2HFKGAb9UXXFLMa","type":"text","x":-415.6906159355258,"y":1121.5925724184867,"width":201.28494262695312,"height":59.074062771267336,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b0T","roundness":null,"seed":144681170,"version":885,"versionNonce":139180105,"isDeleted":false,"boundElements":[],"updated":1785885091760,"link":null,"locked":false,"text":"Exemplo ","fontSize":47.25925021701387,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Exemplo ","autoResize":true,"lineHeight":1.25},{"id":"zjtd-8BsmvIEDGha-sQJM","type":"arrow","x":-323.4022146497182,"y":1062.240850548912,"width":646.6666666666665,"height":331.11114501953136,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":4,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b0U","roundness":{"type":2},"seed":411121550,"version":504,"versionNonce":278906665,"isDeleted":false,"boundElements":[],"updated":1785885091760,"link":null,"locked":false,"points":[[0,0],[86.66666666666652,-322.2221883138021],[646.6666666666665,-331.11114501953136]],"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow","elbowed":false},{"id":"O-IXF_prgxTApuGEEBzXo","type":"line","x":-412.7275654565452,"y":1188.6031776401894,"width":176.29631890190967,"height":0,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":4,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b0W","roundness":{"type":2},"seed":1205779150,"version":56,"versionNonce":1431239177,"isDeleted":false,"boundElements":[],"updated":1785885091760,"link":null,"locked":false,"points":[[0,0],[176.29631890190967,0]],"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":null,"polygon":false},{"id":"HPOGYfkMSrZSbu700kkYh","type":"text","x":1595.1303090812876,"y":2628.569861067063,"width":536.9765625000002,"height":650,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b0X","roundness":null,"seed":1746437030,"version":492,"versionNonce":1117750653,"isDeleted":false,"boundElements":[],"updated":1785885668700,"link":null,"locked":false,"text":"• Movimentação de cargas perigosas, que exige\ncontrole rigoroso para evitar acidentes.\n\n• Ausência ou irregularidade da documentação\nobrigatória, impedindo a liberação da carga.\n\n•Classificação incorreta ou inexistente do risco\nquímico, comprometendo a segurança da operação.\n\n• Registro de produtos químicos inativos ou inválidos,\nque não devem ser utilizados em novas cargas.\n\n• Falta de um responsável técnico, impossibilitando o\nacompanhamento adequado da carga.\n\n• Liberação indevida de cargas bloqueadas, canceladas\nou em inspeção, colocando em risco a operação\nportuária.\n\n• Controle do status da carga, garantindo que ela siga\ncorretamente todas as etapas do processo antes da\nmovimentação.\n\n• Cumprimento das regras de negócio e de segurança,\nevitando inconsistências e garantindo a conformidade\ndas operações","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"• Movimentação de cargas perigosas, que exige controle rigoroso para evitar acidentes.\n\n• Ausência ou irregularidade da documentação obrigatória, impedindo a liberação da carga.\n\n•Classificação incorreta ou inexistente do risco químico, comprometendo a segurança da operação.\n\n• Registro de produtos químicos inativos ou inválidos, que não devem ser utilizados em novas cargas.\n\n• Falta de um responsável técnico, impossibilitando o acompanhamento adequado da carga.\n\n• Liberação indevida de cargas bloqueadas, canceladas ou em inspeção, colocando em risco a operação portuária.\n\n• Controle do status da carga, garantindo que ela siga corretamente todas as etapas do processo antes da movimentação.\n\n• Cumprimento das regras de negócio e de segurança, evitando inconsistências e garantindo a conformidade das operações","autoResize":false,"lineHeight":1.25},{"id":"ui8lm7ESgFGtcNOzI02mB","type":"text","x":1583.1762391918282,"y":897.0871547674049,"width":822.5321180555565,"height":725,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b0Y","roundness":null,"seed":1414686451,"version":485,"versionNonce":742181833,"isDeleted":false,"boundElements":[],"updated":1785885091760,"link":null,"locked":false,"text":"1. Homologação e Cadastro de Produtos Químicos:\nO processo inicial onde o administrador cadastra o produto químico informando\ndados cadastrais e sua respectiva classe de risco, definindo se ele está apto ou\ninativo para uso no porto.  \n\n2. Registro e Abertura da Carga Química:\nO operador portuário registra a carga associando-a a um produto químico ativo,\nespecificando volume, quantidade, tipo de carga/acondicionamento, além de definir o\nresponsável técnico, a origem e o destino planejado. A carga nasce sob um status\nrestritivo inicial (ex: pendente ou bloqueada).  \n\n3. Gestão e Validação de Documentação Obrigatória:\nO analista de documentação anexa, revisa e valida licenças, laudos e certificados\nobrigatórios exigidos para o tipo de carga química transportada.  \n\n4. Inspeção e Auditoria de Segurança:\nO analista de qualidade ou segurança realiza a vistoria física ou documental da\ncarga e do local de armazenamento para garantir que não há inconformidades.  \n\n5. Decisão de Liberação ou Bloqueio (Barreira de Segurança):\nProcesso sistêmico e operacional onde, com base no cumprimento de todas as regras\nde negócio (documentação válida, produto ativo, inspeção aprovada), a carga é\nliberada para movimentação ou mantida bloqueada/cancelada. Esse processo pode\nser realizado pelo gestor operacional.\n\n6. Monitoramento do Ciclo de Vida e Histórico:\nAcompanhamento contínuo dos status da carga (ex: em trânsito, armazenada,\ninspecionada) e registro de todo o histórico de alterações para fins de auditoria e\nrastreabilidade.  ","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1. Homologação e Cadastro de Produtos Químicos:\nO processo inicial onde o administrador cadastra o produto químico informando dados cadastrais e sua respectiva classe de risco, definindo se ele está apto ou inativo para uso no porto.  \n\n2. Registro e Abertura da Carga Química:\nO operador portuário registra a carga associando-a a um produto químico ativo, especificando volume, quantidade, tipo de carga/acondicionamento, além de definir o responsável técnico, a origem e o destino planejado. A carga nasce sob um status restritivo inicial (ex: pendente ou bloqueada).  \n\n3. Gestão e Validação de Documentação Obrigatória:\nO analista de documentação anexa, revisa e valida licenças, laudos e certificados obrigatórios exigidos para o tipo de carga química transportada.  \n\n4. Inspeção e Auditoria de Segurança:\nO analista de qualidade ou segurança realiza a vistoria física ou documental da carga e do local de armazenamento para garantir que não há inconformidades.  \n\n5. Decisão de Liberação ou Bloqueio (Barreira de Segurança):\nProcesso sistêmico e operacional onde, com base no cumprimento de todas as regras de negócio (documentação válida, produto ativo, inspeção aprovada), a carga é liberada para movimentação ou mantida bloqueada/cancelada. Esse processo pode ser realizado pelo gestor operacional.\n\n6. Monitoramento do Ciclo de Vida e Histórico:\nAcompanhamento contínuo dos status da carga (ex: em trânsito, armazenada, inspecionada) e registro de todo o histórico de alterações para fins de auditoria e rastreabilidade.  ","autoResize":false,"lineHeight":1.25},{"id":"ylp_6ks721dgFxA4vx9V0","type":"text","x":1584.1353184553889,"y":1756.9020047805577,"width":729.574620078733,"height":675,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b0a","roundness":null,"seed":893918791,"version":265,"versionNonce":1277323945,"isDeleted":false,"boundElements":[],"updated":1785885091760,"link":null,"locked":false,"text":"1. Cadastro de produtos químicos – Registrar os produtos químicos que\npoderão ser utilizados nas operações portuárias.\n\n2. Registro de cargas químicas – Cadastrar cada carga contendo\ninformações como produto associado, quantidade e classificação de risco.\n\n3. Associação da carga ao produto químico – Vincular cada carga ao\nrespectivo produto químico cadastrado.\n\n4. Registro e validação da documentação obrigatória – Garantir que todos\nos documentos exigidos estejam presentes e válidos.\n\n5. Definição do responsável técnico – Informar o profissional responsável\npela carga química.\n\n6. Acompanhamento e atualização do status da carga – Controlar as\ndiferentes etapas do processo, desde o registro até a liberação ou\nbloqueio da carga.\n\n7. Validação das regras de segurança – Verificar se a carga atende às\nregras de negócio antes de ser movimentada.\n\n8. Bloqueio ou liberação da carga – Permitir ou impedir a movimentação da\ncarga conforme o cumprimento dos requisitos estabelecidos.\n\n9. Consulta ao histórico e ao status das cargas – Acompanhar todas as\nalterações e o histórico de cada carga registrada.","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1. Cadastro de produtos químicos – Registrar os produtos químicos que poderão ser utilizados nas operações portuárias.\n\n2. Registro de cargas químicas – Cadastrar cada carga contendo informações como produto associado, quantidade e classificação de risco.\n\n3. Associação da carga ao produto químico – Vincular cada carga ao respectivo produto químico cadastrado.\n\n4. Registro e validação da documentação obrigatória – Garantir que todos os documentos exigidos estejam presentes e válidos.\n\n5. Definição do responsável técnico – Informar o profissional responsável pela carga química.\n\n6. Acompanhamento e atualização do status da carga – Controlar as diferentes etapas do processo, desde o registro até a liberação ou bloqueio da carga.\n\n7. Validação das regras de segurança – Verificar se a carga atende às regras de negócio antes de ser movimentada.\n\n8. Bloqueio ou liberação da carga – Permitir ou impedir a movimentação da carga conforme o cumprimento dos requisitos estabelecidos.\n\n9. Consulta ao histórico e ao status das cargas – Acompanhar todas as alterações e o histórico de cada carga registrada.","autoResize":false,"lineHeight":1.25},{"id":"Gm2F5THwRLLH3xOY_Hrhg","type":"text","x":1600.438857547821,"y":3439.095389835418,"width":715.547991071429,"height":750,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b0o","roundness":null,"seed":438177469,"version":1460,"versionNonce":1765568061,"isDeleted":false,"boundElements":[],"updated":1785885672915,"link":null,"locked":false,"text":"Automação dos fluxos de aprovação e validação, permitindo que regras\nde negócio sejam executadas automaticamente para liberar, bloquear ou\nencaminhar cargas para inspeção, reduzindo intervenções manuais.\n\nAplicação móvel para operações em campo, possibilitando que operadores,\ninspetores e responsáveis técnicos realizem consultas, inspeções, anexem\ndocumentos e registrem ocorrências diretamente pelo dispositivo móvel.\n\nIntegração com sistemas externos, como sistemas portuários,\ntransportadoras e órgãos reguladores, automatizando o\ncompartilhamento de informações e reduzindo retrabalho.\n\nPainéis gerenciais (Dashboards) para acompanhamento em tempo real dos\nindicadores operacionais, cargas em andamento, bloqueios, inspeções\npendentes e métricas de desempenho.\n\nNotificações e alertas automáticos, informando usuários sobre\ndocumentos próximos do vencimento, cargas bloqueadas, inspeções\npendentes e alterações de status.\n\nUtilização de Inteligência Artificial como apoio à decisão, por meio de um\nagente capaz de analisar o histórico das cargas, classificações de risco,\ninspeções anteriores e padrões operacionais para auxiliar na validação de\nsegurança, identificação de inconsistências, auditorias e apoio à tomada\nde decisão. O agente atuará apenas como suporte, mantendo a decisão\nfinal sob responsabilidade dos profissionais envolvidos.\n\nEscalabilidade da arquitetura, permitindo a futura evolução da aplicação\npara APIs independentes, microsserviços e novas interfaces (web e\nmobile), conforme o crescimento das necessidades do negócio.","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Automação dos fluxos de aprovação e validação, permitindo que regras de negócio sejam executadas automaticamente para liberar, bloquear ou encaminhar cargas para inspeção, reduzindo intervenções manuais.\n\nAplicação móvel para operações em campo, possibilitando que operadores, inspetores e responsáveis técnicos realizem consultas, inspeções, anexem documentos e registrem ocorrências diretamente pelo dispositivo móvel.\n\nIntegração com sistemas externos, como sistemas portuários, transportadoras e órgãos reguladores, automatizando o compartilhamento de informações e reduzindo retrabalho.\n\nPainéis gerenciais (Dashboards) para acompanhamento em tempo real dos indicadores operacionais, cargas em andamento, bloqueios, inspeções pendentes e métricas de desempenho.\n\nNotificações e alertas automáticos, informando usuários sobre documentos próximos do vencimento, cargas bloqueadas, inspeções pendentes e alterações de status.\n\nUtilização de Inteligência Artificial como apoio à decisão, por meio de um agente capaz de analisar o histórico das cargas, classificações de risco, inspeções anteriores e padrões operacionais para auxiliar na validação de segurança, identificação de inconsistências, auditorias e apoio à tomada de decisão. O agente atuará apenas como suporte, mantendo a decisão final sob responsabilidade dos profissionais envolvidos.\n\nEscalabilidade da arquitetura, permitindo a futura evolução da aplicação para APIs independentes, microsserviços e novas interfaces (web e mobile), conforme o crescimento das necessidades do negócio.","autoResize":false,"lineHeight":1.25},{"id":"lEEXQnGLtLaKy8Wb81o9U","type":"text","x":3818.7717624660017,"y":149.24559346122936,"width":231.3359375,"height":59.074062771267336,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b0p","roundness":null,"seed":306632310,"version":995,"versionNonce":1430406927,"isDeleted":false,"boundElements":[],"updated":1785938883732,"link":null,"locked":false,"text":"Entidades","fontSize":47.25925021701387,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Entidades","autoResize":true,"lineHeight":1.25},{"id":"c9A6Bm5FjJeo4dgMBCVkT","type":"text","x":4262.687305000905,"y":-270.9777770585947,"width":399.6094182331079,"height":98.80956922258639,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b0r","roundness":null,"seed":88516522,"version":458,"versionNonce":1760724918,"isDeleted":false,"boundElements":[],"updated":1785885866564,"link":null,"locked":false,"text":"DDD","fontSize":79.04765537806911,"fontFamily":5,"textAlign":"center","verticalAlign":"top","containerId":null,"originalText":"DDD","autoResize":false,"lineHeight":1.25},{"id":"U5zejLkKxtlaFi3P3Ok1I","type":"ellipse","x":3930.105444865037,"y":-331.0170489246833,"width":1057.7777099609375,"height":222.22218831380212,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":4,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b0s","roundness":{"type":2},"seed":1311253098,"version":205,"versionNonce":144391978,"isDeleted":false,"boundElements":[],"updated":1785885858284,"link":null,"locked":false},{"id":"7rvTn40-0F1gY6dmng6Xy","type":"text","x":10977.686377917413,"y":-107.37177728937797,"width":238.09266662597656,"height":59.074062771267336,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b1F","roundness":null,"seed":970006087,"version":2258,"versionNonce":589750981,"isDeleted":false,"boundElements":[],"updated":1786575080981,"link":null,"locked":false,"text":"Agregados","fontSize":47.25925021701387,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Agregados","autoResize":true,"lineHeight":1.25},{"id":"tTQPjzHcz6tRBcekwqiob","type":"text","x":12897.461404268457,"y":-170.88788742443563,"width":308.3193664550781,"height":59.074062771267336,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b1I","roundness":null,"seed":1923000231,"version":1687,"versionNonce":519513349,"isDeleted":false,"boundElements":[],"updated":1786574529239,"link":null,"locked":false,"text":"Casos de uso","fontSize":47.25925021701387,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Casos de uso","autoResize":true,"lineHeight":1.25},{"id":"td1Eqh4_71f73mGBEFtkN","type":"text","x":26881.274500089858,"y":-268.60752443037575,"width":415.23291015625,"height":59.074062771267336,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b1U","roundness":null,"seed":1931384967,"version":1801,"versionNonce":1661741395,"isDeleted":false,"boundElements":[],"updated":1786580042917,"link":null,"locked":false,"text":"Regras de negócio","fontSize":47.25925021701387,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Regras de negócio","autoResize":true,"lineHeight":1.25},{"id":"AVdCjDzkQqyC4CN3_Wd1f","type":"text","x":7207.99263322915,"y":-88.64000888956974,"width":385.4180908203125,"height":59.074062771267336,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b1Y","roundness":null,"seed":925765129,"version":1524,"versionNonce":997061733,"isDeleted":false,"boundElements":[],"updated":1786575107437,"link":null,"locked":false,"text":"Linguagem ubíqua","fontSize":47.25925021701387,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Linguagem ubíqua","autoResize":true,"lineHeight":1.25},{"id":"P1hDnODf8T03J9O03i2U5","type":"text","x":26803.33885302154,"y":-134.3577708339417,"width":677.0096256631675,"height":1430.727130123267,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b2X","roundness":null,"seed":1434864295,"version":1320,"versionNonce":282910481,"isDeleted":false,"boundElements":[],"updated":1786661035017,"link":null,"locked":false,"text":"\n• Um produto químico não pode ser cadastrado sem nome\ne classe de risco.\n\n• Um produto químico inativo não pode ser utilizado em\nnovos registros de cargas. \n\n• Uma carga química não pode ser registrada sem um\nproduto químico associado. \n \n• Uma carga química não pode ser registrada com um\nproduto químico inativo. \n\n• A carga química deve possuir uma classificação de risco\nválida. \n\n• A quantidade da carga deve ser maior que zero. \n\n• Toda carga química deve possuir um responsável\ntécnico informado. \n\n• Uma carga química não pode ser liberada sem a\ndocumentação obrigatória aprovada e válida. \n\n• Uma carga em inspeção não pode ser finalizada sem um\nparecer favorável. \n\n• Uma carga bloqueada não pode sofrer movimentação\nlogística nem ser liberada. \n\n• Uma carga cancelada não pode ser liberada ou\nmovimentada. \n\n• Devem ser respeitadas rigorosamente as transições de\nstatus permitidas pela máquina de estados da carga.\n\n• O sistema deve retornar apenas cargas pertencentes\nao escopo de visualização permitido ao usuário.\n\n• O histórico das cargas deve ser imutável, garantindo\nrastreabilidade e auditoria das operações portuárias.\n\n• Documentos vencidos impedem a liberação da carga.\n\n• A carga deve possuir documentação preliminar\nhabilitada para permitir a solicitação de inspeção física.\n","fontSize":24.35280221486412,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"\n• Um produto químico não pode ser cadastrado sem nome e classe de risco.\n\n• Um produto químico inativo não pode ser utilizado em novos registros de cargas. \n\n• Uma carga química não pode ser registrada sem um produto químico associado. \n \n• Uma carga química não pode ser registrada com um produto químico inativo. \n\n• A carga química deve possuir uma classificação de risco válida. \n\n• A quantidade da carga deve ser maior que zero. \n\n• Toda carga química deve possuir um responsável técnico informado. \n\n• Uma carga química não pode ser liberada sem a documentação obrigatória aprovada e válida. \n\n• Uma carga em inspeção não pode ser finalizada sem um parecer favorável. \n\n• Uma carga bloqueada não pode sofrer movimentação logística nem ser liberada. \n\n• Uma carga cancelada não pode ser liberada ou movimentada. \n\n• Devem ser respeitadas rigorosamente as transições de status permitidas pela máquina de estados da carga.\n\n• O sistema deve retornar apenas cargas pertencentes ao escopo de visualização permitido ao usuário.\n\n• O histórico das cargas deve ser imutável, garantindo rastreabilidade e auditoria das operações portuárias.\n\n• Documentos vencidos impedem a liberação da carga.\n\n• A carga deve possuir documentação preliminar habilitada para permitir a solicitação de inspeção física.\n","autoResize":false,"lineHeight":1.25},{"id":"vDe-W56leMn_Y1E68CjoF","type":"text","x":8955.392769362594,"y":-82.67843222948073,"width":382.39410400390625,"height":59.074062771267336,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b2a","roundness":null,"seed":1088425321,"version":1563,"versionNonce":320588427,"isDeleted":false,"boundElements":[],"updated":1786575087447,"link":null,"locked":false,"text":"Objetos de valor","fontSize":47.25925021701387,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Objetos de valor","autoResize":true,"lineHeight":1.25},{"id":"Ch-tghtaM8TMXjUmo9eiC","type":"text","x":3318.827205435376,"y":380.1144444828577,"width":186.3399200439453,"height":35,"angle":0,"strokeColor":"#099268","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["g6DenuwO7KeoNkWGrnifQ","0FgkyGXMnxX15u0V16kHK"],"frameId":null,"index":"b3L","roundness":null,"seed":2071014959,"version":392,"versionNonce":1770883702,"isDeleted":false,"boundElements":[],"updated":1786055857773,"link":null,"locked":false,"text":"Carga Química","fontSize":28,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Carga Química","autoResize":true,"lineHeight":1.25},{"id":"vmKKiAPeHM9ykgDwtku4a","type":"line","x":3317.772152343543,"y":425.7332934300571,"width":191.04761217912483,"height":0,"angle":0,"strokeColor":"#099268","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":["g6DenuwO7KeoNkWGrnifQ","0FgkyGXMnxX15u0V16kHK"],"frameId":null,"index":"b3M","roundness":{"type":2},"seed":279547983,"version":297,"versionNonce":933284790,"isDeleted":false,"boundElements":[],"updated":1786055857773,"link":null,"locked":false,"points":[[0,0],[191.04761217912483,0]],"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":null,"polygon":false},{"id":"DKLC-UZvphmvluWqjeU_O","type":"text","x":3317.0732093793254,"y":470.30104019653703,"width":1130.439208984375,"height":100,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["0FgkyGXMnxX15u0V16kHK"],"frameId":null,"index":"b3N","roundness":null,"seed":991569441,"version":936,"versionNonce":2084168950,"isDeleted":false,"boundElements":[],"updated":1786055857773,"link":null,"locked":false,"text":"Representa uma carga de produto químico registrada para movimentação no Porto de Santos. É a principal\nentidade do domínio, responsável por controlar todo o ciclo de vida da carga, desde seu cadastro até sua liberação,\nbloqueio ou cancelamento. Também garante que todas as regras de segurança e conformidade sejam atendidas\nantes da movimentação.","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Representa uma carga de produto químico registrada para movimentação no Porto de Santos. É a principal\nentidade do domínio, responsável por controlar todo o ciclo de vida da carga, desde seu cadastro até sua liberação,\nbloqueio ou cancelamento. Também garante que todas as regras de segurança e conformidade sejam atendidas\nantes da movimentação.","autoResize":true,"lineHeight":1.25},{"id":"Tu5fDE9YyDyaYulyaWqhc","type":"text","x":3319.214410206038,"y":612.9218877620341,"width":209.47979736328125,"height":25,"angle":0,"strokeColor":"#099268","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["0FgkyGXMnxX15u0V16kHK"],"frameId":null,"index":"b3O","roundness":null,"seed":1661758241,"version":237,"versionNonce":417191478,"isDeleted":false,"boundElements":[],"updated":1786055857773,"link":null,"locked":false,"text":"• Principais atributos","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"• Principais atributos","autoResize":true,"lineHeight":1.25},{"id":"R0VWnKrLA_AQed1kHaVRs","type":"text","x":3355.716281957728,"y":669.3362793310613,"width":227.95982360839844,"height":275,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["0FgkyGXMnxX15u0V16kHK"],"frameId":null,"index":"b3P","roundness":null,"seed":1290406497,"version":410,"versionNonce":1987157878,"isDeleted":false,"boundElements":[],"updated":1786055857773,"link":null,"locked":false,"text":"• Identificador (UUID)\n\n• Quantidade\n\n• Tipo de carga\n\n• Status de carga\n\n• Origem\n\n• Destino","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"• Identificador (UUID)\n\n• Quantidade\n\n• Tipo de carga\n\n• Status de carga\n\n• Origem\n\n• Destino","autoResize":true,"lineHeight":1.25},{"id":"UwtYfRpu0FeXznZ88XuDA","type":"text","x":3319.2692813932367,"y":988.0728218110967,"width":193.07981872558594,"height":25,"angle":0,"strokeColor":"#099268","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["0FgkyGXMnxX15u0V16kHK"],"frameId":null,"index":"b3Q","roundness":null,"seed":566352207,"version":332,"versionNonce":423248054,"isDeleted":false,"boundElements":[],"updated":1786055857773,"link":null,"locked":false,"text":"• Responsabilidades","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"• Responsabilidades","autoResize":true,"lineHeight":1.25},{"id":"kNqO0ewUeH5V4mvfTmOmE","type":"text","x":3360.0294208585683,"y":1041.2871729201925,"width":791.0795288085938,"height":250,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["0FgkyGXMnxX15u0V16kHK"