ness":null,"seed":927222757,"version":63,"versionNonce":39272581,"isDeleted":true,"boundElements":null,"updated":1787698777953,"link":null,"locked":false,"text":"Para garantir consistência entre o Front-End e o Back-End, o projeto utilizará\numa arquitetura de","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Para garantir consistência entre o Front-End e o Back-End, o projeto utilizará uma arquitetura de","autoResize":false,"lineHeight":1.25},{"id":"h5YXV5Fz7nf-GehAgK9KB","type":"text","x":41335.42583044629,"y":4572.438984767378,"width":94.5799560546875,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bDJ","roundness":null,"seed":115511531,"version":63,"versionNonce":1637319621,"isDeleted":true,"boundElements":null,"updated":1787698779304,"link":null,"locked":false,"text":"monorepo.","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"monorepo.","autoResize":true,"lineHeight":1.25},{"id":"19t5N3QvL5OxvuvfPNvCv","type":"text","x":41005.77608069043,"y":4594.938984767378,"width":753.8794555664062,"height":50,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bDK","roundness":null,"seed":989562693,"version":63,"versionNonce":1214727947,"isDeleted":true,"boundElements":null,"updated":1787698779304,"link":null,"locked":false,"text":"● Single Source of Truth (Fonte Única da Verdade): As interfaces do domínio\n(ICarga e","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"● Single Source of Truth (Fonte Única da Verdade): As interfaces do domínio (ICarga e","autoResize":false,"lineHeight":1.25},{"id":"fWCEQijctV3HB7onCagC_","type":"text","x":40984.526050172855,"y":4654.938984767378,"width":796.3795166015625,"height":50,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bDL","roundness":null,"seed":701971339,"version":63,"versionNonce":1239204645,"isDeleted":true,"boundElements":null,"updated":1787698779304,"link":null,"locked":false,"text":"EStatusCarga, por exemplo) são definidas uma única vez na camada compartilhada\n(em","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"EStatusCarga, por exemplo) são definidas uma única vez na camada compartilhada (em","autoResize":false,"lineHeight":1.25},{"id":"aJOSCamJ7g54e7ORFw1hv","type":"text","x":41276.23588904004,"y":4727.438984767378,"width":212.9598388671875,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bDM","roundness":null,"seed":1861506725,"version":63,"versionNonce":1637887403,"isDeleted":true,"boundElements":null,"updated":1787698779304,"link":null,"locked":false,"text":"alguma pasta shared);","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"alguma pasta shared);","autoResize":true,"lineHeight":1.25},{"id":"Cq8VMKwxuEZFimi-_uTZO","type":"text","x":41001.46602209668,"y":4749.938984767378,"width":762.4995727539062,"height":50,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bDN","roundness":null,"seed":1780322859,"version":63,"versionNonce":704845445,"isDeleted":true,"boundElements":null,"updated":1787698779304,"link":null,"locked":false,"text":"● Sincronia Automática: Alterações nos contratos de API no