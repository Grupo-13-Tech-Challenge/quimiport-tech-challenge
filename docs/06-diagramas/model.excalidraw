:1.25},{"id":"zP9ZbZpUhnf17vQqEphX-","type":"image","x":25250.780471109156,"y":370.99125215950585,"width":1137,"height":661,"angle":0,"strokeColor":"transparent","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bAd","roundness":null,"seed":134560187,"version":144,"versionNonce":1951487733,"isDeleted":false,"boundElements":[],"updated":1786667108593,"link":null,"locked":false,"status":"saved","fileId":"26d54d4f0373480ff63661c417e370d9baa3a7de","scale":[1,1],"crop":null},{"id":"_93Ggo5I69TSpgSLzmYM4","type":"text","x":26165.607609706076,"y":-321.2324029942174,"width":140.6909942626953,"height":127.44007255755385,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bAe","roundness":null,"seed":1970059019,"version":498,"versionNonce":940010891,"isDeleted":false,"boundElements":[],"updated":1786667006153,"link":null,"locked":false,"text":"OK","fontSize":101.95205804604308,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"OK","autoResize":true,"lineHeight":1.25},{"id":"txeoiN1PnJSHnmvNF54cd","type":"text","x":21658.94094303941,"y":-280.3990696608842,"width":140.6909942626953,"height":127.44007255755385,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bAf","roundness":null,"seed":316820005,"version":372,"versionNonce":620006469,"isDeleted":false,"boundElements":[],"updated":1786667010581,"link":null,"locked":false,"text":"OK","fontSize":101.95205804604308,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"OK","autoResize":true,"lineHeight":1.25},{"id":"NtKdGcKlEBppO7sYoyzMO","type":"freedraw","x":22513.545465764666,"y":3622.986835163187,"width":61.2121027166213,"height":9.69696044921875,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bAn","roundness":null,"seed":626976821,"version":12,"versionNonce":793934965,"isDeleted":false,"boundElements":[],"updated":1786731767293,"link":null,"locked":false,"points":[[0,0],[1.8181818181838025,0],[10.303011807529401,-1.212130459871787],[20.6060791015625,-2.4242331764912706],[30.9090909090919,-4.848494096235754],[42.4242609197463,-6.666675914417283],[56.36363636363967,-9.090909090909008],[59.3939208984375,-9.69696044921875],[60.6060791015625,-9.69696044921875],[61.2121027166213,-9.69696044921875],[61.2121027166213,-9.69696044921875]],"pressures":[],"simulatePressure":true,"strokeOptions":{"variability":"constant","streamline":0.5}},{"id":"BPsLv4LQxpxbq60UFa6Op","type":"text","x":33012.8352992266,"y":2719.178162101349,"width":2047.403190104167,"height":160.5555555555556,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bAr","roundness":null,"seed":2009208103,"version":77,"versionNonce":1641194886,"isDeleted":false,"boundElements":[],"updated":1787183349529,"link":null,"locked":false,"text":"DIAGRAMA DE ARQUITETURA","fontSize":128.44444444444446,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"DIAGRAMA DE ARQUITETURA","autoResize":true,"lineHeight":1.25},{"id":"_O1YwMKP4LzX3GsEqmN-L","type":"text","x":38006.88664862983,"y":-412.8409503457821,"width":1200.334228515625,"height":73.71605922196221,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bAt","roundness":null,"seed":2133944667,"version":2224,"versionNonce":1930903578,"isDeleted":false,"boundElements":[],"updated":1787183545821,"link":null,"locked":false,"text":"8. Planejamento de qualidade de software","fontSize":58.97284737756977,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"8. Planejamento de qualidade de software","autoResize":true,"lineHeight":1.25},{"id":"srNhBXunPI0Ip1iIPHPES","type":"text","x":37193.091177220194,"y":-244.68233783563926,"width":859.2329711914062,"height":1100.0656707891787,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bAu","roundness":null,"seed":1432688661,"version":1868,"versionNonce":108936827,"isDeleted":false,"boundElements":[],"updated":1787182316148,"link":null,"locked":false,"text":"1 - Quais regras de negócio precisam ser testadas ?\n\n\n• Não permitir cadastro de produto químico sem nome.\n\n• Não permitir cadastro de produto químico sem classe de risco.\n\n• Não permitir utilização de produto químico inativo em novas cargas.\n\n• Não permitir registro de carga sem produto químico associado.\n\n• Não permitir registro de carga com produto químico inativo.\n\n• Não permitir registro de carga sem classificação de risco.\n\n• Validar que a quantidade da carga seja maior que zero.\n\n• Exigir responsável técnico para toda carga.\n\n• Não permitir liberação sem documentação obrigatória aprovada.\n\n• Não permitir liberação com documentos vencidos.\n\n• Não permitir movimentação de carga bloqueada.\n\n• Não permitir liberação ou movimentação de carga cancelada.\n\n• Não permitir finalização de carga em inspeção sem parecer favorável.\n\n• Validar as transições permitidas de status da carga.\n\n• Garantir que o histórico seja imutável para manter a rastreabilidade.\n\n\n","fontSize":25.144358189466946,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1 - Quais regras de negócio precisam ser testadas ?\n\n\n• Não permitir cadastro de produto químico sem nome.\n\n• Não permitir cadastro de produto químico sem classe de risco.\n\n• Não permitir utilização de produto químico inativo em novas cargas.\n\n• Não permitir registro de carga sem produto químico associado.\n\n• Não permitir registro de carga com produto químico inativo.\n\n• Não permitir registro de carga sem classificação de risco.\n\n• Validar que a quantidade da carga seja maior que zero.\n\n• Exigir responsável técnico para toda carga.\n\n• Não permitir liberação sem documentação obrigatória aprovada.\n\n• Não permitir liberação com documentos vencidos.\n\n• Não permitir movimentação de carga bloqueada.\n\n• Não permitir liberação ou movimentação de carga cancelada.\n\n• Não permitir finalização de carga em inspeção sem parecer favorável.\n\n• Validar as transições permitidas de status da carga.\n\n• Garantir que o histórico seja imutável para manter a rastreabilidade.\n\n\n","autoResize":true,"lineHeight":1.25},{"id":"DmuBj_oQhgcLOBO0htr0z","type":"image","x":31843.115231878015,"y":3003.7837440531525,"width":4860.000000000001,"height":3645.0000000000005,"angle":0,"strokeColor":"transparent","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bAv","roundness":null,"seed":1338472681,"version":87,"versionNonce":1772518217,"isDeleted":false,"boundElements":[],"updated":1787253240320,"link":null,"locked":false,"status":"saved","fileId":"6d3826b725d957a61ab94a87c34f05edcd471365","scale":[1,1],"crop":null},{"id":"3xW_n12USRrhddPuEOGCY","type":"text","x":38334.90047918775,"y":-251.13683292028418,"width":512.6934204101562,"height":785.761193420842,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bAw","roundness":null,"seed":539504693,"version":2052,"versionNonce":1329803419,"isDeleted":false,"boundElements":[],"updated":1787182321529,"link":null,"locked":false,"text":"2 - Quais casos de uso são mais críticos?\n\n\n• Os casos de uso mais críticos são:\n\n• Cadastrar produto químico;\n\n• Registrar carga química;\n\n• Registrar documentação obrigatória;\n\n• Solicitar inspeção física;\n\n• Realizar inspeção;\n\n• Liberar carga;\n\n• Bloquear carga;\n\n• Cancelar carga;\n\n• Alterar status da carga.\n\n\n","fontSize":25.144358189466946,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"2 - Quais casos de uso são mais críticos?\n\n\n• Os casos de uso mais críticos são:\n\n• Cadastrar produto químico;\n\n• Registrar carga química;\n\n• Registrar documentação obrigatória;\n\n• Solicitar inspeção física;\n\n• Realizar inspeção;\n\n• Liberar carga;\n\n• Bloquear carga;\n\n• Cancelar carga;\n\n• Alterar status da carga.\n\n\n","autoResize":true,"lineHeight":1.25},{"id":"J7_WtjBxiSZNvUkQ27Dsi","type":"text","x":39121.04702425974,"y":-253.11529160851023,"width":1230.1121826171875,"height":502.8871637893389,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bAx","roundness":null,"seed":7218869,"version":2127,"versionNonce":1632817755,"isDeleted":false,"boundElements":[],"updated":1787182380457,"link":null,"locked":false,"text":"3 - Quais tipos de teste serão utilizados?\n\n\nSerão utilizados:\n\n• Testes unitários, para validar regras de negócio e comportamentos individuais.\n\n• Testes de integração, para verificar a comunicação entre os componentes da aplicação.\n\n• Testes de fluxo, para validar os principais processos do sistema.\n\n• Testes de validação, para verificar se entradas e operações inválidas são corretamente rejeitadas.\n\n\n\n","fontSize":25.144358189466946,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"3 - Quais tipos de teste serão utilizados?\n\n\nSerão utilizados:\n\n• Testes unitários, para validar regras de negócio e comportamentos individuais.\n\n• Testes de integração, para verificar a comunicação entre os componentes da aplicação.\n\n• Testes de fluxo, para validar os principais processos do sistema.\n\n• Testes de validação, para verificar se entradas e operações inválidas são corretamente rejeitadas.\n\n\n\n","autoResize":true,"lineHeight":1.25},{"id":"y0zVmsx29LMweb4XdidJ-","type":"text","x":37191.1512491376,"y":1085.123901285914,"width":912.5010948868805,"height":565.7480592630062,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bAy","roundness":null,"seed":308083067,"version":2292,"versionNonce":625312763,"isDeleted":false,"boundElements":[],"updated":1787182592731,"link":null,"locked":false,"text":"4 - Como o grupo pretende aplicar testes unitários?\n\n\nOs testes unitários serão aplicados principalmente sobre as regras de\nnegócio do domínio, validando cada comportamento de forma isolada.\nSerão criados cenários positivos e negativos. Por exemplo:\n\n• Quantidade maior que zero → deve permitir.\n\n• Quantidade igual ou menor que zero → deve rejeitar.\n\n• Produto químico ativo → pode ser utilizado em uma carga.\n\n• Produto químico inativo → deve impedir o registro da carga.\n\n• Documentação válida → pode permitir a liberação.\n\n• Documentação ausente ou vencida → deve impedir a liberação.","fontSize":25.144358189466946,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"4 - Como o grupo pretende aplicar testes unitários?\n\n\nOs testes unitários serão aplicados principalmente sobre as regras de negócio do domínio, validando cada comportamento de forma isolada.\nSerão criados cenários positivos e negativos. Por exemplo:\n\n• Quantidade maior que zero → deve permitir.\n\n• Quantidade igual ou menor que zero → deve rejeitar.\n\n• Produto químico ativo → pode ser utilizado em uma carga.\n\n• Produto químico inativo → deve impedir o registro da carga.\n\n• Documentação válida → pode permitir a liberação.\n\n• Documentação ausente ou vencida → deve impedir a liberação.","autoResize":false,"lineHeight":1.25},{"id":"8jQ0_cPi89FQS0YTHme-U","type":"text","x":38320.57015954113,"y":1062.3622505466385,"width":912.5010948868805,"height":660.0394024735073,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bAz","roundness":null,"seed":160280405,"version":2372,"versionNonce":272002325,"isDeleted":false,"boundElements":[],"updated":1787182691266,"link":null,"locked":false,"text":"5 - Como o grupo pretende aplicar testes de integração futuramente?\n\n\nOs testes de integração serão utilizados futuramente para verificar o\nfuncionamento conjunto dos componentes da aplicação.\n\nSerão testados fluxos como:\n\n•  Cadastro de produto → registro da carga;\n\n•  Registro da carga → inclusão da documentação;\n\n•  Documentação → solicitação de inspeção;\n\n•  Inspeção → liberação da carga;\n\n•  Bloqueio → tentativa de movimentação;\n\n•  Alteração de status → persistência do novo status;\n\n•  Registro de alterações → consulta do histórico.","fontSize":25.144358189466946,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"5 - Como o grupo pretende aplicar testes de integração futuramente?\n\n\nOs testes de integração serão utilizados futuramente para verificar o funcionamento conjunto dos componentes da aplicação.\n\nSerão testados fluxos como:\n\n•  Cadastro de produto → registro da carga;\n\n•  Registro da carga → inclusão da documentação;\n\n•  Documentação → solicitação de inspeção;\n\n•  Inspeção → liberação da carga;\n\n•  Bloqueio → tentativa de movimentação;\n\n•  Alteração de status → persistência do novo status;\n\n•  Registro de alterações → consulta do histórico.","autoResize":false,"lineHeight":1.25},{"id":"YOfxmM5ForxS51DMl2hUX","type":"text","x":39353.49632480863,"y":1066.214266420587,"width":1005.1998570850626,"height":534.3176115261725,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bB4","roundness":null,"seed":1350748635,"version":2486,"versionNonce":1183875477,"isDeleted":false,"boundElements":[],"updated":1787182726185,"link":null,"locked":false,"text":"6 - Como o grupo pretende validar fluxos principais?\n\nOs principais fluxos serão validados simulando o ciclo de vida da carga química e\nverificando se cada etapa respeita as regras de negócio.\n\nO principal fluxo planejado será:\nCadastro da carga → Documentação → Inspeção → Aprovação → Liberação\n\n\nTambém serão testados fluxos de exceção, como:\n\n• Carga bloqueada → tentativa de movimentação → operação recusada\n\n• Carga cancelada → tentativa de liberação → operação recusada\n\nAlém disso, serão validadas as transições de status da carga, conforme exigido\npelo enunciado.","fontSize":25.144358189466946,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"6 - Como o grupo pretende validar fluxos principais?\n\nOs principais fluxos serão validados simulando o ciclo de vida da carga química e verificando se cada etapa respeita as regras de negócio.\n\nO principal fluxo planejado será:\nCadastro da carga → Documentação → Inspeção → Aprovação → Liberação\n\n\nTambém serão testados fluxos de exceção, como:\n\n• Carga bloqueada → tentativa de movimentação → operação recusada\n\n• Carga cancelada → tentativa de liberação → operação recusada\n\nAlém disso, serão validadas as transições de status da carga, conforme exigido pelo enunciado.","autoResize":false,"lineHeight":1.25},{"id":"zKjWwgNZKobWW4aBqL4Pj","type":"text","x":37939.25310877485,"y":1930.1668560271246,"width":1444.5233041991887,"height":691.469850210341,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bB5","roundness":null,"seed":1205696411,"version":2532,"versionNonce":545117269,"isDeleted":false,"boundElements":[],"updated":1787182851281,"link":null,"locked":false,"text":"7. Como o grupo pretende organizar mocks e dados simulados?\n\nOs mocks e dados simulados serão organizados para representar diferentes situações do domínio, permitindo testar\ntanto cenários válidos quanto inválidos.\n\nSerão utilizados dados simulados de:\n\n• Produtos químicos ativos e inativos\n\n• Cargas com quantidades válidas e inválidas\n\n• Documentações válidas, vencidas e ausentes\n\n• Cargas em diferentes status\n\n• Inspeções com diferentes resultados\n\n• Usuários com diferentes permissões de visualização.\n\nOs mocks serão utilizados principalmente nos testes unitários para isolar as regras de negócio, enquanto os dados\nsimulados poderão ser utilizados nos testes de integração para reproduzir cenários próximos aos fluxos reais da\naplicação.","fontSize":25.144358189466946,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"7. Como o grupo pretende organizar mocks e dados simulados?\n\nOs mocks e dados simulados serão organizados para representar diferentes situações do domínio, permitindo testar tanto cenários válidos quanto inválidos.\n\nSerão utilizados dados simulados de:\n\n• Produtos químicos ativos e inativos\n\n• Cargas com quantidades válidas e inválidas\n\n• Documentações válidas, vencidas e ausentes\n\n• Cargas em diferentes status\n\n• Inspeções com diferentes resultados\n\n• Usuários com diferentes permissões de visualização.\n\nOs mocks serão utilizados principalmente nos testes unitários para isolar as regras de negócio, enquanto os dados simulados poderão ser utilizados nos testes de integração para reproduzir cenários próximos aos fluxos reais da aplicação.","autoResize":false,"lineHeight":1.25},{"id":"y8tTF4aO0EG6RsMCQX20i","type":"text","x":40931.21139262853,"y":-290.3238067483648,"width":1481.2081298828125,"height":147.43211844392442,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bB7","roundness":null,"seed":1693903942,"version":2271,"versionNonce":1544071558,"isDeleted":false,"boundElements":[],"updated":1787184109879,"link":null,"locked":false,"text":"9 - Aplicação de Javascript Avançado e Typescript \nEBERT ","fontSize":58.97284737756977,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"9 - Aplicação de Javascript Avançado e Typescript \nEBERT ","autoResize":true,"lineHeight":1.25},{"id":"l9EP6p7ityWSUAWyUAUgT","type":"text","x":43100.188618885855,"y":-303.4657771373836,"width":824.3990478515625,"height":163.33333333333348,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bB9","roundness":null,"seed":152186010,"version":85,"versionNonce":951070534,"isDeleted":false,"boundElements":[],"updated":1787184125677,"link":null,"locked":false,"text":"10. Decisões arquiteturais\n(TODOS)","fontSize":65.3333333333334,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"10. Decisões arquiteturais\n(TODOS)","autoResize":true,"lineHeight":1.25},{"id":"JLurjuIwlhbArlpwZAtL3","type":"text","x":44875.845649627234,"y":-675.9657771373838,"width":1353.0491943359375,"height":326.66666666666697,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strok