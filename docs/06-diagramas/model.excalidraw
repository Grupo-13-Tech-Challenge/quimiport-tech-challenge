,{"id":"QB9MoR5eXI4jzuJc2UY0v","type":"text","x":43288.730473865355,"y":238.84771492610844,"width":518.3595581054688,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bDT","roundness":null,"seed":207244453,"version":19,"versionNonce":1749828933,"isDeleted":true,"boundElements":null,"updated":1787698654305,"link":null,"locked":false,"text":"• Por que separar domínio, aplicação e infraestrutura;","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"• Por que separar domínio, aplicação e infraestrutura;","autoResize":true,"lineHeight":1.25},{"id":"DQefvwOTeQaiNWkRU2iod","type":"text","x":43196.89050804504,"y":273.84771492610844,"width":702.0394897460938,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bDU","roundness":null,"seed":918158379,"version":19,"versionNonce":1165581707,"isDeleted":true,"boundElements":null,"updated":1787698654305,"link":null,"locked":false,"text":"• Por que concentrar regras de negócio no domínio ou nos casos de uso;","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"• Por que concentrar regras de negócio no domínio ou nos casos de uso;","autoResize":true,"lineHeight":1.25},{"id":"Vgxpd3qhr-10G_SsMlP7F","type":"text","x":43404.10036217102,"y":308.84771492610844,"width":287.6197814941406,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bDV","roundness":null,"seed":655585285,"version":19,"versionNonce":1870484645,"isDeleted":true,"boundElements":null,"updated":1787698654305,"link":null,"locked":false,"text":"• Por que utilizar TypeScript;","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"• Por que utilizar TypeScript;","autoResize":true,"lineHeight":1.25},{"id":"Kysh9NzT9QPwpfn-iWbwM","type":"text","x":43323.71039329895,"y":343.84771492610844,"width":448.39971923828125,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bDW","roundness":null,"seed":438255307,"version":19,"versionNonce":1361802283,"isDeleted":true,"boundElements":null,"updated":1787698654305,"link":null,"locked":false,"text":"• Como o projeto poderá evoluir para backend;","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"• Como o projeto poderá evoluir para backend;","autoResize":true,"lineHeight":1.25},{"id":"PZvTGWFP5wTR5a85xC-OE","type":"text","x":43319.510396350706,"y":378.84771492610844,"width":456.7997131347656,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bDX","roundness":null,"seed":160507749,"version":19,"versionNonce":1083537413,"isDeleted":true,"boundElements":null,"updated":1787698654305,"link":null,"locked":false,"text":"• Como o projeto poderá evoluir para frontend;","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"• Como o projeto poderá evoluir para frontend;","autoResize":true,"lineHeight":1.25},{"id":"eFQeeuNEDCYwVSr_pntR7","type":"text","x":43333.830388416136,"y":413.84771492610844,"width":428.15972900390625,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bDY","roundness":null,"seed":1896033643,"version":19,"versionNonce":1470215883,"isDeleted":true,"boundElements":null,"updated":1787698654305,"link":null,"locked":false,"text":"• Como o projeto poderá evoluir para mobile;","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"• Como o projeto poderá evoluir para mobile;","autoResize":true,"lineHeight":1.25},{"id":"3J6FZ7l1GoLz9Ysv_FxQc","type":"text","x":43293.330418933714,"y":448.84771492610844,"width":509.15966796875,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bDZ","roundness":null,"seed":1981870789,"version":19,"versionNonce":898772837,"isDeleted":true,"boundElements":null,"updated":1787698654305,"link":null,"locked":false,"text":"• Como o projeto poderá evoluir para microsserviços;","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"• Como o projeto poderá evoluir para microsserviços;","autoResize":true,"lineHeight":1.25},{"id":"pmjXc6ZVPwOTt4XMt8X6Q","type":"text","x":43278.59042869934,"y":483.84771492610844,"width":538.6396484375,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bDa","roundness":null,"seed":783304715,"version":19,"versionNonce":1198957931,"isDeleted":true,"boundElements":null,"updated":1787698654305,"link":null,"locked":false,"text":"• Como o grupo pretende evitar acoplamento excessivo.","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"• Como o grupo pretende evitar acoplamento excessivo.","autoResize":true,"lineHeight":1.25},{"id":"mai6Co526qeF2gOtLeXmm","type":"text","x":43096.778939786775,"y":-70.59672951833599,"width":2908.81787109375,"height":9925,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bDb","roundness":null,"seed":1602648395,"version":3373,"versionNonce":1871010405,"isDeleted":false,"boundElements":[],"updated":1787702220630,"link":null,"locked":false,"text":"10. Decisões Arquiteturais\n\nDurante a modelagem do QuimiPort, foram tomadas decisões arquiteturais com o objetivo de manter a aplicação organizada, desacoplada, testável e preparada para evoluir ao longo das próximas fases do projeto.\n\nA solução será inicialmente baseada em uma arquitetura monolítica modular em camadas, utilizando princípios de Domain Driven Design (DDD), SOLID e Clean Architecture.\n\nAlém disso, backend, frontend e mobile serão tratados como aplicações independentes, cada uma organizada em seu próprio monorepo.\n\nPor que separar Domain, Application, Interfaces e Infrastructure?\n\nUm dos principais benefícios dessa separação é manter o núcleo da aplicação independente das tecnologias utilizadas nas camadas externas.\n\nA camada de Domain concentra os principais conceitos do negócio, como entidades, objetos de valor, agregados e regras de negócio. Dessa forma, alterações relacionadas a banco de dados, frameworks, APIs ou mecanismos de entrada não devem provocar alterações nas regras centrais da aplicação.\n\nEssa organização também facilita a evolução do sistema, pois novas funcionalidades poderão ser adicionadas com menor impacto sobre outros módulos e menor risco de regressões.\n\nOutro benefício está relacionado aos testes. Como as regras de negócio não dependerão diretamente de banco de dados, servidor ou framework, será possível testar o domínio de forma isolada.\n\nA direção das dependências seguirá os princípios da Clean Architecture:\n\nInterfaces\n    ↓\nApplication\n    ↓\nDomain\n\nInfrastructure → contratos utilizados pelas camadas internas\n\nO Domain não deverá conhecer detalhes de Infrastructure, banco de dados ou frameworks.\n\nEssa decisão busca manter o núcleo da aplicação estável mesmo que tecnologias externas sejam substituídas durante a evolução do projeto.\n\nPor que concentrar regras de negócio no Domain ou nos casos de uso?\n\nA concentração das regras de negócio no Domain e nos casos de uso tem como objetivo proteger os comportamentos centrais da aplicação e impedir que essas regras fiquem espalhadas em controllers, banco de dados ou outras tecnologias externas.\n\nAs regras diretamente relacionadas às entidades, objetos de valor e agregados deverão permanecer no Domain.\n\nPor exemplo:\n\na quantidade da carga deve ser maior que zero;\num Produto Químico inativo não pode ser utilizado em uma nova carga;\numa carga bloqueada não pode ser movimentada;\numa carga cancelada não pode ser liberada;\nas alterações de status devem respeitar a máquina de estados da carga.\n\nJá a camada de Application ficará responsável principalmente pela coordenação dos casos de uso.\n\nExemplo:\n\nReceber solicitação\n        ↓\nBuscar informações necessárias\n        ↓\nExecutar comportamento do domínio\n        ↓\nPersistir alterações\n        ↓\nRetornar resultado\n\nDessa forma, o Domain concentra as regras que precisam ser protegidas, enquanto os casos de uso coordenam as operações necessárias para executar determinado fluxo.\n\nEssa separação também reduz a dependência do sistema em tecnologias específicas e facilita futuras alterações nas camadas externas.\n\nPor que utilizar TypeScript?\n\nO TypeScript foi escolhido por permitir o aproveitamento do ecossistema JavaScript com o benefício adicional da verificação estática de tipos durante o desenvolvimento.\n\nEntre os principais benefícios considerados estão:\n\ndetecção antecipada de erros durante o desenvolvimento;\nmaior segurança durante manutenção e refatorações;\ndefinição explícita de contratos;\nutilização de tipos e interfaces;\nmelhor experiência de desenvolvimento com autocomplete e IntelliSense;\nfacilidade de utilização tanto no backend quanto no frontend e mobile;\nmaior clareza na modelagem dos conceitos do domínio.\n\nNo QuimiPort, TypeScript poderá ser utilizado para representar conceitos como:\n\nStatusCarga\nStatusProduto\nClasseRisco\nTipoDocumento\nStatusValidacao\n\nTambém poderá ser utilizado na definição de:\n\nDTOs;\ncontratos de repositórios;\nentradas e saídas de casos de uso;\ninterfaces entre módulos;\nrespostas das APIs.\n\nA utilização da mesma linguagem nas diferentes aplicações também reduz a curva de aprendizado e facilita a padronização técnica entre as frentes do projeto.\n\nPor que iniciar com uma arquitetura monolítica modular?\n\nNesta primeira etapa, o QuimiPort será desenvolvido como um monólito modular.\n\nA escolha evita introduzir prematuramente a complexidade operacional de uma arquitetura distribuída enquanto o domínio ainda está sendo consolidado.\n\nMesmo sendo um monólito, a aplicação será organizada em módulos e camadas com responsabilidades bem definidas.\n\nEssa abordagem traz benefícios como:\n\nmenor complexidade inicial;\nfacilidade de desenvolvimento e execução local;\nmaior simplicidade nos testes;\nmenor complexidade de deploy;\nfacilidade de comunicação entre módulos;\npossibilidade de evoluir a arquitetura futuramente.\n\nA modularização também permitirá identificar, com a evolução do projeto, quais partes realmente necessitam de independência.\n\nCaso surjam necessidades concretas de escalabilidade, implantação independente ou autonomia entre partes do domínio, alguns módulos poderão futuramente ser extraídos para serviços independentes.\n\nEstratégia de organização dos repositórios\n\nBackend, frontend e mobile serão mantidos em monorepos independentes.\n\nA estrutura conceitual será:\n\nquimiport-backend/\n    └── aplicação e módulos relacionados ao backend\n\nquimiport-frontend/\n    └── aplicação web e pacotes relacionados ao frontend\n\nquimiport-mobile/\n    └── aplicação mobile e pacotes relacionados ao mobile\n\nEssa decisão permite que cada aplicação possua:\n\nciclo de desenvolvimento próprio;\ndependências próprias;\nversionamento independente;\npipeline de CI/CD próprio;\nprocesso de implantação independente;\nbibliotecas internas específicas de seu contexto.\n\nÉ importante destacar que backend, frontend e mobile não representam as camadas da Clean Architecture.\n\nSão aplicações distintas da solução.\n\nDentro do backend, por exemplo, continuarão existindo as camadas:\n\nInterfaces\nApplication\nDomain\nInfrastructure\n\nA comunicação entre os diferentes monorepos será realizada por contratos bem definidos, principalmente por meio da API disponibilizada pelo backend.\n\nComo o projeto poderá evoluir para backend?\n\nO backend poderá disponibilizar uma API REST única, consumida inicialmente tanto pelo frontend web quanto pela aplicação mobile.\n\nO backend será mantido em um monorepo próprio, separado dos projetos de frontend e mobile.\n\nInternamente, continuará seguindo a arquitetura definida nesta fase:\n\nInterfaces\n    ↓\nApplication\n    ↓\nDomain\n    ↑\nInfrastructure\n\nA camada de Interfaces poderá conter elementos como:\n\ncontrollers;\nrotas;\nDTOs;\nmiddlewares.\n\nA camada Application ficará responsável pela coordenação dos casos de uso.\n\nA camada Domain continuará concentrando as entidades, agregados, objetos de valor e regras de negócio.\n\nA Infrastructure será responsável pelos detalhes tecnológicos, como:\n\npersistência;\nbanco de dados;\nimplementação de repositórios;\nintegrações externas.\n\nO monorepo do backend poderá organizar diferentes módulos e pacotes internos relacionados à própria aplicação, sem misturar dependências específicas de frontend ou mobile.\n\nSerão utilizados princípios de SOLID, DDD e Clean Architecture para preservar a separação de responsabilidades e reduzir o acoplamento.\n\nComo o projeto poderá evoluir para frontend?\n\nO frontend será desenvolvido em um monorepo próprio, independente do backend e da aplicação mobile.\n\nA aplicação web consumirá os serviços disponibilizados pela API REST do QuimiPort.\n\nO frontend deverá considerar:\n\nutilização de TypeScript;\ntratamento padronizado de erros;\ntestes unitários;\ndesign responsivo;\norganização de componentes reutilizáveis;\nseparação entre apresentação, gerenciamento de estado e comunicação com serviços externos.\n\nO monorepo do frontend poderá concentrar a aplicação web e outros pacotes ou bibliotecas específicos dessa frente.\n\nPrincípios de SOLID e separação de responsabilidades inspirados na Clean Architecture poderão ser utilizados para manter a aplicação organizada e facilitar sua evolução.\n\nPor possuir um monorepo independente, o frontend poderá alterar suas dependências, ferramentas e processos de implantação sem afetar diretamente o backend ou o mobile.\n\nComo o projeto poderá evoluir para mobile?\n\nA aplicação mobile também será mantida em um monorepo próprio, separado dos projetos de frontend e backend.\n\nInicialmente, o mobile poderá consumir a mesma API disponibilizada pelo backend.\n\nA aplicação deverá considerar:\n\nutilização de TypeScript;\ncompatibilidade com dispositivos móveis;\notimização de desempenho;\ntratamento de erros;\ntestes;\nseparação de responsabilidades;\nexperiência adequada para operações realizadas em campo.\n\nNo contexto do QuimiPort, a aplicação mobile poderá futuramente permitir funcionalidades como:\n\nconsulta de cargas;\nacompanhamento de status;\nrealização ou apoio às inspeções;\nregistro de ocorrências;\nenvio ou consulta de documentos;\nconsulta de informações operacionais em campo.\n\nO monorepo mobile poderá concentrar a aplicação e bibliotecas específicas dessa frente.\n\nPor possuir um repositório independente, sua evolução tecnológica poderá ocorrer sem criar dependência direta com a aplicação web.\n\nComo frontend, backend e mobile irão se comunicar?\n\nComo as três aplicações estarão em monorepos diferentes, não será utilizada importação direta de código entre os repositórios.\n\nA comunicação acontecerá por contratos definidos entre as aplicações.\n\nDe forma simplificada:\n\nFrontend ──────┐\n               │\n               ▼\n            API REST\n               ▲\n               │\nMobile ────────┘\n               │\n               ▼\n            Backend\n\nO backend será responsável por expor contratos que poderão definir:\n\nendpoints;\nformatos de requisição;\nformatos de resposta;\nDTOs;\ncódigos de erro;\nregras de autenticação;\nversionamento da API.\n\nFrontend e mobile deverão utilizar esses contratos sem conhecer detalhes internos da implementação do backend.\n\nCaso futuramente exista a necessidade de compartilhar código entre os diferentes monorepos, poderão ser avaliados pacotes versionados e publicados de forma independente.\n\nComo o projeto poderá evoluir para microsserviços?\n\nNeste momento, o backend permanecerá como um monólito modular dentro de seu próprio monorepo.\n\nA utilização de monorepos separados para backend, frontend e mobile não significa que o backend já esteja dividido em microsserviços. São decisões diferentes.\n\nUma eventual evolução para microsserviços deverá acontecer de forma gradual e somente quando surgirem necessidades concretas, como:\n\nescalabilidade independente;\nimplantação independente;\nautonomia entre diferentes capacidades do sistema;\nnecessidades diferentes de disponibilidade;\naumento significativo da complexidade do domínio.\n\nA decomposição deverá considerar principalmente os Bounded Contexts identificados no domínio.\n\nNão será adotada a regra de transformar automaticamente cada entidade ou agregado em um microsserviço.\n\nAlguns contextos que poderão ser avaliados futuramente são:\n\nGestão de Produtos\nGestão de Cargas\nDocumentação\nInspeções\n\nEsses limites deverão ser validados conforme o domínio evoluir.\n\nQuando houver necessidade de maior desacoplamento entre os serviços, poderá ser utilizada comunicação assíncrona baseada em eventos.\n\nCada microsserviço também poderá possuir sua própria persistência, evitando o compartilhamento direto de banco de dados entre serviços.\n\nA decisão de migrar para microsserviços deverá ser baseada em necessidades reais do projeto, evitando adicionar complexidade distribuída sem um benefício claro.\n\nComo o grupo pretende evitar acoplamento excessivo?\n\nO grupo pretende evitar acoplamento excessivo tanto dentro das aplicações quanto entre backend, frontend e mobile.\n\nNo backend, serão utilizados princípios da Clean Architecture e do Dependency Inversion Principle.\n\nAs camadas internas deverão depender de contratos e abstrações, evitando dependência direta de tecnologias específicas.\n\nPor exemplo, o Domain não deverá depender diretamente de:\n\nPostgreSQL\nMongoDB\nPrisma\nExpress\nNestJS\nou outro framework específico\n\nA comunicação com a Infrastructure poderá ocorrer por contratos.\n\nExemplo conceitual:\n\nApplication\n     ↓\nICargaRepository\n     ↑\nInfrastructure\n     ↓\nCargaRepositoryPostgres\n\nIsso permite que a implementação do repositório ou até mesmo o banco de dados seja alterado sem modificar diretamente as regras de negócio.\n\nTambém serão adotadas práticas como:\n\nresponsabilidades bem definidas entre módulos;\ncontratos e interfaces entre camadas;\nDTOs nas fronteiras da aplicação;\nausência de acesso direto ao banco de dados fora da Infrastructure;\nentidades sem dependência direta de frameworks;\nmódulos com responsabilidades específicas;\ncomunicação entre as aplicações por meio de contratos públicos.\n\nEntre os diferentes monorepos, a relação será conceitualmente:\n\nquimiport-frontend\n        │\n        │ API\n        ▼\nquimiport-backend\n        ▲\n        │ API\n        │\nquimiport-mobile\n\nFrontend e mobile não terão acesso direto ao banco de dados ou às regras internas do backend.\n\nDa mesma forma, alterações internas na implementação do backend não deverão exigir mudanças nas outras aplicações enquanto os contratos públicos da API forem preservados.\n\nDessa forma, o grupo busca reduzir tanto o acoplamento entre as camadas internas quanto o acoplamento entre as diferentes aplicações da solução.\n\nDireção das dependências\n\nComo princípio geral da arquitetura, as dependências deverão apontar para as camadas mais internas.\n\nO Domain será a camada mais independente e não deverá conhecer Interfaces ou Infrastructure.\n\nA Application utilizará os elementos definidos pelo Domain.\n\nInterfaces e Infrastructure ficarão responsáveis por adaptar tecnologias e mecanismos externos às necessidades das camadas internas.\n\nEssa decisão busca garantir que mudanças em banco de dados, frameworks, APIs ou interfaces tenham o menor impacto possível sobre as regras de negócio do QuimiPort.\n\nResumo das principais decisões\n\nAs principais decisões arquiteturais tomadas nesta fase são:\n\nutilização inicial de uma arquitetura monolítica modular;\naplicação dos princípios de DDD, SOLID e Clean Architecture;\nseparação entre Domain, Application, Interfaces e Infrastructure;\nconcentração das invariantes e regras centrais no Domain;\nutilização dos casos de uso para coordenar os fluxos da aplicação;\nutilização de TypeScript nas diferentes aplicações;\nbackend disponibilizando uma API REST;\nutilização de um monorepo independente para backend;\nutilização de um monorepo independente para frontend;\nutilização de um monorepo independente para mobile;\ncomunicação entre aplicações por contratos bem definidos;\nproteção do Domain contra dependências de frameworks e infraestrutura;\neventual evolução para microsserviços somente mediante necessidade real;\nutilização de Bounded Contexts como referência para uma futura decomposição do backend.","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"10. Decisões Arquiteturais\n\nDurante a modelagem do QuimiPort, foram tomadas decisões arquiteturais com o objetivo de manter a aplicação organizada, desacoplada, testável e preparada para evoluir ao longo das próximas fases do projeto.\n\nA solução será inicialmente baseada em uma arquitetura monolítica modular em camadas, utilizando princípios de Domain Driven Design (DDD), SOLID e Clean Architecture.\n\nAlém disso, backend, frontend e mobile serão tratados como aplicações independentes, cada uma organizada em seu próprio monorepo.\n\nPor que separar Domain, Application, Interfaces e Infrastructure?\n\nUm dos principais benefícios dessa separação é manter o núcleo da aplicação independente das tecnologias utilizadas nas camadas externas.\n\nA camada de Domain concentra os principais conceitos do negócio, como entidades, objetos de valor, agregados e regras de negócio. Dessa forma, alterações relacionadas a banco de dados, frameworks, APIs ou mecanismos de entrada não devem provocar alterações nas regras centrais da aplicação.\n\nEssa organização também facilita a evolução do sistema, pois novas funcionalidades poderão ser adicionadas com menor impacto sobre outros módulos e menor risco de regressões.\n\nOutro benefício está relacionado aos testes. Como as regras de negócio não dependerão diretamente de banco de dados, servidor ou framework, será possível testar o domínio de forma isolada.\n\nA direção das dependências seguirá os princípios da Clean Architecture:\n\nInterfaces\n    ↓\nApplication\n    ↓\nDomain\n\nInfrastructure → contratos utilizados pelas camadas internas\n\nO Domain não deverá conhecer detalhes de Infrastructure, banco de dados ou frameworks.\n\nEssa decisão busca manter o núcleo da aplicação estável mesmo que tecnologias externas sejam substituídas durante a evolução do projeto.\n\nPor que concentrar regras de negócio no Domain ou nos casos de uso?\n\nA concentração das regras de negócio no Domain e nos casos de uso tem como objetivo proteger os comportamentos centrais da aplicação e impedir que essas regras fiquem espalhadas em controllers, banco de dados ou outras tecnologias externas.\n\nAs regras diretamente relacionadas às entidades, objetos de valor e agregados deverão permanecer no Domain.\n\nPor exemplo:\n\na quantidade da carga deve ser maior que zero;\num Produto Químico inativo não pode ser utilizado em uma nova carga;\numa carga bloqueada não pode ser movimentada;\numa carga cancelada não pode ser liberada;\nas alterações de status devem respeitar a máquina de estados da carga.\n\nJá a camada de Application ficará responsável principalmente pela coordenação dos casos de uso.\n\nExemplo:\n\nReceber solicitação\n        ↓\nBuscar informações necessárias\n        ↓\nExecutar comportamento do domínio\n        ↓\nPersistir alterações\n        ↓\nRetornar resultado\n\nDessa forma, o Domain concentra as regras que precisam ser protegidas, enquanto os casos de uso coordenam as operações necessárias para executar determinado fluxo.\n\nEssa separação também reduz a dependência do sistema em tecnologias específicas e facilita futuras alterações nas camadas externas.\n\nPor que utilizar TypeScript?\n\nO TypeScript foi escolhido por permitir o aproveitamento do ecossistema JavaScript com o benefício adicional da verificação estática de tipos durante o desenvolvimento.\n\nEntre os principais benefícios considerados estão:\n\ndetecção antecipada de erros durante o desenvolvimento;\nmaior segurança durante manutenção e refatorações;\ndefinição explícita de contratos;\nutilização de tipos e interfaces;\nmelhor experiência de desenvolvimento com autocomplete e IntelliSense;\nfacilidade de utilização tanto no backend quanto no frontend e mobile;\nmaior clareza na modelagem dos conceitos do domínio.\n\nNo QuimiPort, TypeScript poderá ser utilizado para representar conceitos como:\n\nStatusCarga\nStatusProduto\nClasseRisco\nTipoDocumento\nStatusValidacao\n\nTambém poderá ser utilizado na definição de:\n\nDTOs;\ncontratos de repositórios;\nentradas e saídas de casos de uso;\ninterfaces entre módulos;\nrespostas das APIs.\n\nA utilização da mesma linguagem nas diferentes aplicações também reduz a curva de aprendizado e facilita a padronização técnica entre as frentes do projeto.\n\nPor que iniciar com uma arquitetura monolítica modular?\n\nNesta primeira etapa, o QuimiPort será desenvolvido como um monólito modular.\n\nA escolha evita introduzir prematuramente a complexidade operacional de uma arquitetura distribuída enquanto o domínio ainda está sendo consolidado.\n\nMesmo sendo um monólito, a aplicação será organizada em módulos e camadas com responsabilidades bem definidas.\n\nEssa abordagem traz benefícios como:\n\nmenor complexidade inicial;\nfacilidade de desenvolvimento e execução local;\nmaior simplicidade nos testes;\nmenor complexidade de deploy;\nfacilidade de comunicação entre módulos;\npossibilidade de evoluir a arquitetura futuramente.\n\nA modularização também permitirá identificar, com a evolução do projeto, quais partes realmente necessitam de independência.\n\nCaso surjam necessidades concretas de escalabilidade, implantação independente ou autonomia entre partes do domínio, alguns módulos poderão futuramente ser extraídos para serviços independentes.\n\nEstratégia de organização dos repositórios\n\nBackend, frontend e mobile serão mantidos em monorepos independentes.\n\nA estrutura conceitual será:\n\nquimiport-backend/\n    └── aplicação e módulos relacionados ao backend\n\nquimiport-frontend/\n    └── aplicação web e pacotes relacionados ao frontend\n\nquimiport-mobile/\n    └── aplicação mobile e pacotes relacionados ao mobile\n\nEssa decisão permite que cada aplicação possua:\n\nciclo de desenvolvimento próprio;\ndependências próprias;\nversionamento independente;\npipeline de CI/CD próprio;\nprocesso de implantação independente;\nbibliotecas internas específicas de seu contexto.\n\nÉ importante destacar que backend, frontend e mobile não representam as camadas da Clean Architecture.\n\nSão aplicações distintas da solução.\n\nDentro do backend, por exemplo, continuarão existindo as camadas:\n\nInterfaces\nApplication\nDomain\nInfrastructure\n\nA comunicação entre os diferentes monorepos será realizada por contratos bem definidos, principalmente por meio da API disponibilizada pelo backend.\n\nComo o projeto poderá evoluir para backend?\n\nO backend poderá disponibilizar uma API REST única, consumida inicialmente tanto pelo frontend web quanto pela aplicação mobile.\n\nO backend será mantido em um monorepo próprio, separado dos projetos de frontend e mobile.\n\nInternamente, continuará seguindo a arquitetura definida nesta fase:\n\nInterfaces\n    ↓\nApplication\n    ↓\nDomain\n    ↑\nInfrastructure\n\nA camada de Interfaces poderá conter elementos como:\n\ncontrollers;\nrotas;\nDTOs;\nmiddlewares.\n\nA camada Application ficará responsável pela coordenação dos casos de uso.\n\nA camada Domain continuará concentrando as entidades, agregados, objetos de valor e regras de negócio.\n\nA Infrastructure será responsável pelos detalhes tecnológicos, como:\n\npersistência;\nbanco de dados;\nimplementação de repositórios;\nintegrações externas.\n\nO monorepo do backend poderá organizar diferentes módulos e pacotes internos relacionados à própria aplicação, sem misturar dependências específicas de frontend ou mobile.\n\nSerão utilizados princípios de SOLID, DDD e Clean Architecture para preservar a separação de responsabilidades e reduzir o acoplamento.\n\nComo o projeto poderá evoluir para frontend?\n\nO frontend será desenvolvido em um monorepo próprio, independente do backend e da aplicação mobile.\n\nA aplicação web consumirá os serviços disponibilizados pela API REST do QuimiPort.\n\nO frontend deverá considerar:\n\nutilização de TypeScript;\ntratamento padronizado de erros;\ntestes unitários;\ndesign responsivo;\norganização de componentes reutilizáveis;\nseparação entre apresentação, gerenciamento de estado e comunicação com serviços externos.\n\nO monorepo do frontend poderá concentrar a aplicação web e outros pacotes ou bibliotecas específicos dessa frente.\n\nPrincípios de SOLID e separação de responsabilidades inspirados na Clean Architecture poderão ser utilizados para manter a aplicação organizada e facilitar sua evolução.\n\nPor possuir um monorepo independente, o frontend poderá alterar suas dependências, ferramentas e processos de implantação sem afetar diretamente o backend ou o mobile.\n\nComo o projeto poderá evoluir para mobile?\n\nA aplicação mobile também será mantida em um monorepo próprio, separado dos projetos de frontend e backend.\n\nInicialmente, o mobile poderá consumir a mesma API disponibilizada pelo backend.\n\nA aplicação deverá considerar:\n\nutilização de TypeScript;\ncompatibilidade com dispositivos móveis;\notimização de desempenho;\ntratamento de erros;\ntestes;\nseparação de responsabilidades;\nexperiência adequada para operações realizadas em campo.\n\nNo contexto do QuimiPort, a aplicação mobile poderá futuramente permitir funcionalidades como:\n\nconsulta de cargas;\nacompanhamento de status;\nrealização ou apoio às inspeções;\nregistro de ocorrências;\nenvio ou consulta de documentos;\nconsulta de informações operacionais em campo.\n\nO monorepo mobile poderá concentrar a aplicação e bibliotecas específicas dessa frente.\n\nPor possuir um repositório independente, sua evolução tecnológica poderá ocorrer sem criar dependência direta com a aplicação web.\n\nComo frontend, backend e mobile irão se comunicar?\n\nComo as três aplicações estarão em monorepos diferentes, não será utilizada importação direta de código entre os repositórios.\n\nA comunicação acontecerá por contratos definidos entre as aplicações.\n\nDe forma simplificada:\n\nFrontend ──────┐\n               │\n               ▼\n            API REST\n               ▲\n               │\nMobile ────────┘\n               │\n               ▼\n            Backend\n\nO backend será responsável por expor contratos que poderão definir:\n\nendpoints;\nformatos de requisição;\nformatos de resposta;\nDTOs;\ncódigos de erro;\nregras de autenticação;\nversionamento da API.\n\nFrontend e mobile deverão utilizar esses contratos sem conhecer detalhes internos da implementação do backend.\n\nCaso futuramente exista a necessidade de compartilhar código entre os diferentes monorepos, poderão ser avaliados pacotes versionados e publicados de forma independente.\n\nComo o projeto poderá evoluir para microsserviços?\n\nNeste momento, o backend permanecerá como um monólito modular dentro de seu próprio monorepo.\n\nA utilização de monorepos separados para backend, frontend e mobile não significa que o backend já esteja dividido em microsserviços. São decisões diferentes.\n\nUma eventual evolução para microsserviços deverá acontecer de forma gradual e somente quando surgirem necessidades concretas, como:\n\nescalabilidade independente;\nimplantação independente;\nautonomia entre diferentes capacidades do sistema;\nnecessidades diferentes de disponibilidade;\naumento significativo da complexidade do domínio.\n\nA decomposição deverá considerar principalmente os Bounded Contexts identificados no domínio.\n\nNão será adotada a regra de transformar automaticamente cada entidade ou agregado em um microsserviço.\n\nAlguns contextos que poderão ser avaliados futuramente são:\n\nGestão de Produtos\nGestão de Cargas\nDocumentação\nInspeções\n\nEsses limites deverão ser validados conforme o domínio evoluir.\n\nQuando houver necessidade de maior desacoplamento entre os serviços, poderá ser utilizada comunicação assíncrona baseada em eventos.\n\nCada microsserviço também poderá possuir sua própria persistência, evitando o compartilhamento direto de banco de dados entre serviços.\n\nA decisão de migrar para microsserviços deverá ser baseada em necessidades reais do projeto, evitando adicionar complexidade distribuída sem um benefício claro.\n\nComo o grupo pretende evitar acoplamento excessivo?\n\nO grupo pretende evitar acoplamento excessivo tanto dentro das aplicações quanto entre backend, frontend e mobile.\n\nNo backend, serão utilizados princípios da Clean Architecture e do Dependency Inversion Principle.\n\nAs camadas internas deverão depender de contratos e abstrações, evitando dependência direta de tecnologias específicas.\n\nPor exemplo, o Domain não deverá depender diretamente de:\n\nPostgreSQL\nMongoDB\nPrisma\nExpress\nNestJS\nou outro framework específico\n\nA comunicação com a Infrastructure poderá ocorrer por contratos.\n\nExemplo conceitual:\n\nApplication\n     ↓\nICargaRepository\n     ↑\nInfrastructure\n     ↓\nCargaRepositoryPostgres\n\nIsso permite que a implementação do repositório ou até mesmo o banco de dados seja alterado sem modificar diretamente as regras de negócio.\n\nTambém serão adotadas práticas como:\n\nresponsabilidades bem definidas entre módulos;\ncontratos e interfaces entre camadas;\nDTOs nas fronteiras da aplicação;\nausência de acesso direto ao banco de dados fora da Infrastructure;\nentidades sem dependência direta de frameworks;\nmódulos com responsabilidades específicas;\ncomunicação entre as aplicações por meio de contratos públicos.\n\nEntre os diferentes monorepos, a relação será conceitualmente:\n\nquimiport-frontend\n        │\n        │ API\n        ▼\nquimiport-backend\n        ▲\n        │ API\n        │\nquimiport-mobile\n\nFrontend e mobile não terão acesso direto ao banco de dados ou às regras internas do backend.\n\nDa mesma forma, alterações internas na implementação do backend não deverão exigir mudanças nas outras aplicações enquanto os contratos públicos da API forem preservados.\n\nDessa forma, o grupo busca reduzir tanto o acoplamento entre as camadas internas quanto o acoplamento entre as diferentes aplicações da solução.\n\nDireção das dependências\n\nComo princípio geral da arquitetura, as dependências deverão apontar para as camadas mais internas.\n\nO Domain será a camada mais independente e não deverá conhecer Interfaces ou Infrastructure.\n\nA Application utilizará os elementos definidos pelo Domain.\n\nInterfaces e Infrastructure ficarão responsáveis por adaptar tecnologias e mecanismos externos às necessidades das camadas internas.\n\nEssa decisão busca garantir que mudanças em banco de dados, frameworks, APIs ou interfaces tenham o menor impacto possível sobre as regras de negócio do QuimiPort.\n\nResumo das principais decisões\n\nAs principais decisões arquiteturais tomadas nesta fase são:\n\nutilização inicial de uma arquitetura monolítica modular;\naplicação dos princípios de DDD, SOLID e Clean Architecture;\nseparação entre Domain, Application, Interfaces e Infrastructure;\nconcentração das invariantes e regras centrais no Domain;\nutilização dos casos de uso para coordenar os fluxos da aplicação;\nutilização de TypeScript nas diferentes aplicações;\nbackend disponibilizando uma API REST;\nutilização de um monorepo independente para backend;\nutilização de um monorepo independente para frontend;\nutilização de um monorepo independente para mobile;\ncomunicação entre aplicações por contratos bem definidos;\nproteção do Domain contra dependências de frameworks e infraestrutura;\neventual evolução para microsserviços somente mediante necessidade real;\nutilização de Bounded Contexts como referência para uma futura decomposição do backend.","autoResize":true,"lineHeight":1.25},{"id":"2KvYfbZ23KWG9YZg5vYd7","type":"text","x":41009.068983076824,"y":-0.3110152326219122,"width":1004.5794067382812,"height":2625,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"bDc","roundness":null,"seed":1193033707,"version":50,"versionNonce":1167594539,"isDeleted":false,"boundElements":null,"updated":1787698780728,"link":null,"locked":false,"text":"9. Aplicação de JavaScript Avançado e TypeScript\n\nUso de tipagem\nTypeScript será utilizado pela verificação estática de tipos, ajudando a detectar erros em desenvolvimento, melhorar refatorações, contratos, autocomplete e manutenção. A tipagem não substitui validações de entrada nem testes.\n\nInterfaces e types\nSerão utilizados para DTOs, contratos de casos de uso, repositórios, serviços e respostas de API. Abstrações também apoiarão o Dependency Inversion Principle.\n\nClasses\nSerão utilizadas quando houver identidade, comportamento, encapsulamento ou invariantes, principalmente em entidades, agregados, determinados Objetos de Valor e erros de domínio. DTOs simples poderão usar interfaces/types.\n\nEnums\nStatusCarga: PENDENTE_DOCUMENTACAO, EM_INSPECAO, LIBERADA, BLOQUEADA, CANCELADA.\nStatusProduto: ATIVO, INATIVO.\nTambém poderão existir TipoDocumento e StatusValidacao.\n\nFunções puras\nSerão utilizadas em validações que não dependem de estado externo, quando fizer sentido.\n\nMódulos ES6+\nUso de import/export para encapsulamento, organização, testabilidade e controle das dependências.\n\nasync/await\nPrevisto para banco de dados, APIs, arquivos e integrações externas.\n\nGenerics\nUtilizados quando houver necessidade real de reutilização com preservação dos tipos, como ApiResponse<T> e resultados paginados.\n\nTratamento de erros\nA aplicação diferenciará erros de domínio, aplicação e infraestrutura. Erros conhecidos poderão ser convertidos em respostas HTTP adequadas sem expor detalhes internos.\n\nOrganização de contratos e tipos compartilhados\nBackend, frontend e mobile serão mantidos em monorepos independentes:\nquimiport-backend/\nquimiport-frontend/\nquimiport-mobile/\n\nNão haverá importação direta de código entre esses repositórios. A comunicação ocorrerá principalmente por contratos de API. Cada monorepo poderá possuir seus próprios módulos/pacotes compartilhados internos. Futuramente poderá ser avaliada documentação OpenAPI ou publicação de pacotes versionados de contratos.","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"9. Aplicação de JavaScript Avançado e TypeScript\n\nUso de tipagem\nTypeScript será utilizado pela verificação estática de tipos, ajudando a detectar erros em desenvolvimento, melhorar refatorações, contratos, autocomplete e manutenção. A tipagem não substitui validações de entrada nem testes.\n\nInterfaces e types\nSerão utilizados para DTOs, contratos de casos de uso, repositórios, serviços e respostas de API. Abstrações também apoiarão o Dependency Inversion Principle.\n\nClasses\nSerão utilizadas quando houver identidade, comportamento, encapsulamento ou invariantes, principalmente em entidades, agregados, determinados Objetos de Valor e erros de domínio. DTOs simples poderão usar interfaces/types.\n\nEnums\nStatusCarga: PENDENTE_DOCUMENTACAO, EM_INSPECAO, LIBERADA, BLOQUEADA, CANCELADA.\nStatusProduto: ATIVO, INATIVO.\nTambém poderão existir TipoDocumento e StatusValidacao.\n\nFunções puras\nSerão utilizadas em validações que não dependem de estado externo, quando fizer sentido.\n\nMódulos ES6+\nUso de import/export para encapsulamento, organização, testabilidade e controle das dependências.\n\nasync/await\nPrevisto para banco de dados, APIs, arquivos e integrações externas.\n\nGenerics\nUtilizados quando houver necessidade real de reutilização com preservação dos tipos, como ApiResponse<T> e resultados paginados.\n\nTratamento de erros\nA aplicação diferenciará erros de domínio, aplicação e infraestrutura. Erros conhecidos poderão ser convertidos em respostas HTTP adequadas sem expor detalhes internos.\n\nOrganização de contratos e tipos compartilhados\nBackend, frontend e mobile serão mantidos em monorepos independentes:\nquimiport-backend/\nquimiport-frontend/\nquimiport-mobile/\n\nNão haverá importação direta de código entre esses repositórios. A comunicação ocorrerá principalmente por contratos de API. Cada monorepo poderá possuir seus próprios módulos/pacotes compartilhados internos. Futuramente poderá ser avaliada documentação OpenAPI ou publicação de pacotes versionados de contratos.","autoResize":true,"lineHeight":1.25}],"appState":{"gridSize":20,"gridStep":5,"gridModeEnabled":false,"viewBackgroundColor":"#ffffff","lockedMultiSelections":{}},"files":{"f3e6c789edfc30e67bd0113a4162110f944daca2":{"mimeType":"image/svg+xml","id":"f3e6c789edfc30e67bd0113a4162110f944daca2","dataURL":"data:image/svg+xml;base64,","created":1785887273751,"lastRetrieved":1785887273751},"1b3fcbb17d23b9491c981a41920703b7d2f06387":{"mimeType":"image/png","id":"1b3fcbb17d23b9491c981a41920703b7d2f06387","dataURL":"data:image/png;base64,","created":1785884031972,"lastRetrieved":1785884031972},"fa4560019041fb7ea9fc556fd3fc2da603b4c15a":{"mimeType":"image/png","id":"fa4560019041fb7ea9fc556fd3fc2da603b4c15a","dataURL":"data:image/png;base64,","created":1785884032003,"lastRetrieved":1785884032003},"3b602f76257f6901842280b44c402cfba027bb40":{"mimeType":"image/png","id":"3b602f76257f6901842280b44c402cfba027bb40","dataURL":"data:image/png;base64,","created":1786059157015,"lastRetrieved":1786059157015},"713c878dd82a505e2246778b67a2f67a0ef3e91d":{"mimeType":"image/png","id":"713c878dd82a505e2246778b67a2f67a0ef3e91d","dataURL":"data:image/png;base64,","created":1786059437671,"lastRetrieved":1786059437671},"d57e714564aa41ae06ca54aaf52a5cae7d5cabb0":{"mimeType":"image/png","id":"d57e714564aa41ae06ca54aaf52a5cae7d5cabb0","dataURL":"data:image/png;base64,","created":1786578971406,"lastRetrieved":1786578971406},"82b9b6940ca4d2754094dd4d5402d8483546bbf0":{"mimeType":"image/svg+xml","id":"82b9b6940ca4d2754094dd4d5402d8483546bbf0","dataURL":"data:image/svg+xml;base64,","created":1786630482709,"lastRetrieved":1786630482709},"144f53e7bd3674bfa0703bb15c679124511b9604":{"mimeType":"image/png","id":"144f53e7bd3674bfa0703bb15c679124511b9604","dataURL":"data:image/png;base64,","created":1786661903564,"lastRetrieved":1786661903564},"c3ce7ab9a237794dcd3806c1b2de400cfef0c43e":{"mimeType":"image/png","id":"c3ce7ab9a237794dcd3806c1b2de400cfef0c43e","dataURL":"data:image/png;base64,","created":1786663125367,"lastRetrieved":1786663125367},"4eeac1e14bb39f447a7dc5936033aa14ebf068ff":{"mimeType":"image/svg+xml","id":"4eeac1e14bb39f447a7dc5936033aa14ebf068ff","dataURL":"data:image/svg+xml;base64,","created":1786665623701,"lastRetrieved":1786665623701},"6fd96bf509b07c1d72b2bbccb6730705197b3ba3":{"mimeType":"image/svg+xml","id":"6fd96bf509b07c1d72b2bbccb6730705197b3ba3","dataURL":"data:image/svg+xml;base64,","created":1786665600869,"lastRetrieved":1786665600869},"ce3db227a1bd640839e6148258983c4cd67e31dd":{"mimeType":"image/svg+xml","id":"ce3db227a1bd640839e6148258983c4cd67e31dd","dataURL":"data:image/svg+xml;base64,","created":1786665981751,"lastRetrieved":1786665981751},"472028abb87f420651426be1df11ccd8b60947b4":{"mimeType":"image/svg+xml","id":"472028abb87f420651426be1df11ccd8b60947b4","dataURL":"data:image/svg+xml;base64,","created":1786665998268,"lastRetrieved":1786665998268},"e92951ecf12e39a7f8ecc5022b8d1d14a19d9364":{"mimeType":"image/svg+xml","id":"e92951ecf12e39a7f8ecc5022b8d1d14a19d9364","dataURL":"data:image/svg+xml;base64,","created":1786666108369,"lastRetrieved":1786666108369},"b0c917b91ab02e530ce20556c5c4895b95bb5ccd":{"mimeType":"image/svg+xml","id":"b0c917b91ab02e530ce20556c5c4895b95bb5ccd","dataURL":"data:image/svg+xml;base64,","created":1786666089272,"lastRetrieved":1786666089272},"a629252008cd71217ff3bedbf6ad541d0447d987":{"mimeType":"image/svg+xml","id":"a629252008cd71217ff3bedbf6ad541d0447d987","dataURL":"data:image/svg+xml;base64,","created":1786666291320,"lastRetrieved":1786666291320},"66557d09512c9276680f193b8d592eda62faa7a7":{"mimeType":"image/svg+xml","id":"66557d09512c9276680f193b8d592eda62faa7a7","dataURL":"data:image/svg+xml;base64,","created":1786666641056,"lastRetrieved":1786666641056},"63574420ff32fba1a7c2d423ef76fde50bfb72fd":{"mimeType":"image/svg+xml","id":"63574420ff32fba1a7c2d423ef76fde50bfb72fd","dataURL":"data:image/svg+xml;base64,","created":1786666799220,"lastRetrieved":1786666799220},"7cf7058c4237d2f2f418355c06a7caf1bea6be2f":{"mimeType":"image/svg+xml","id":"7cf7058c4237d2f2f418355c06a7caf1bea6be2f","dataURL":"data:image/svg+xml;base64,","created":1786666774245,"lastRetrieved":1786666774245},"26d54d4f0373480ff63661c417e370d9baa3a7de":{"mimeType":"image/svg+xml","id":"26d54d4f0373480ff63661c417e370d9baa3a7de","dataURL":"data:image/svg+xml;base64,","created":1786667071300,"lastRetrieved":1786667071300},"6d3826b725d957a61ab94a87c34f05edcd471365":{"mimeType":"image/png","id":"6d3826b725d957a61ab94a87c34f05edcd471365","dataURL":"data:image/png;base64,","created":1787182012123,"lastRetrieved":1787182012123},"7491f68598b416082db3fca2b69cc8f5e22bf03c":{"mimeType":"image/svg+xml","id":"7491f68598b416082db3fca2b69cc8f5e22bf03c","dataURL":"data:image/svg+xml;base64,","created":1787184272663,"lastRetrieved":1787184272663},"04d50bfdf374bfe052a61fd1a6a9e3072ad829dc":{"mimeType":"image/png","id":"04d50bfdf374bfe052a61fd1a6a9e3072ad829dc","dataURL":"data:image/png;base64,","created":1787184682700,"lastRetrieved":1787184682700}}}