ull,"index":"b4C","roundness":null,"seed":378796751,"version":3232,"versionNonce":183052481,"isDeleted":false,"boundElements":[],"updated":1785951797041,"link":null,"locked":false,"text":"Representa as áreas destinadas ao armazenamento das cargas químicas dentro do Porto de Santos. Cada área possui\ncapacidade máxima e define quais classes de risco são compatíveis, garantindo o armazenamento seguro dos produtos","fontSize":19.95971865754981,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Representa as áreas destinadas ao armazenamento das cargas químicas dentro do Porto de Santos. Cada área possui capacidade máxima e define quais classes de risco são compatíveis, garantindo o armazenamento seguro dos produtos","autoResize":false,"lineHeight":1.25},{"id":"iRON9yd6Imq0xIZBjX4cU","type":"text","x":4924.63745812932,"y":3682.601534299053,"width":209.0578909905819,"height":24.94964832193726,"angle":0,"strokeColor":"#099268","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["gDGZmjLwDp2Hpi5KtQ25v"],"frameId":null,"index":"b4D","roundness":null,"seed":587843823,"version":963,"versionNonce":1756055425,"isDeleted":false,"boundElements":[],"updated":1785951716709,"link":null,"locked":false,"text":"• Principais atributos","fontSize":19.95971865754981,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"• Principais atributos","autoResize":true,"lineHeight":1.25},{"id":"208TyAJx7ln7KZM9mZ5zB","type":"text","x":4961.065812661205,"y":3738.902303496785,"width":293.4443664550781,"height":199.59718657549809,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["gDGZmjLwDp2Hpi5KtQ25v"],"frameId":null,"index":"b4E","roundness":null,"seed":1474351887,"version":1504,"versionNonce":394322191,"isDeleted":false,"boundElement